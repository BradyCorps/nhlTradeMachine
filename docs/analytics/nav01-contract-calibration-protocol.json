{
  "version": 1,
  "status": "proceed_market_calibration",
  "target": {
    "name": "shadowExpectedCapShare",
    "unit": "annual cap-share percentage points at signing",
    "inputRule": "pre-signing deal-excluded positional NAV inputs only",
    "exclusions": ["actual cap hit", "cap surplus", "term", "total value", "expiry", "post-signing statistics"]
  },
  "partitions": {
    "train": ["2023-07-01", "2024-07-01"],
    "validation": ["2024-07-01", "2025-07-01"],
    "holdout": ["2025-07-01", "2026-08-01"]
  },
  "sampleGates": {
    "train": { "contracts": 250, "players": 175, "F": 100, "D": 60, "G": 25 },
    "validation": { "contracts": 120, "players": 90, "F": 50, "D": 30, "G": 15 },
    "holdout": { "contracts": 120, "players": 90, "F": 50, "D": 30, "G": 15 }
  },
  "performanceGates": {
    "aggregateMaeImprovementCapSharePp": 0.1,
    "maxPositionMaeRegressionCapSharePp": 0.05,
    "calibrationSlope": [0.85, 1.15],
    "maxSignedBiasCapSharePp": 0.25,
    "interval": "paired 95% bootstrap"
  },
  "marketReferenceGate": {
    "categoryDifferencePp": 15,
    "teamTotalVariationPp": 20,
    "referencePopulation": "market_calibration_eligible",
    "result": "pass"
  },
  "policyFallback": {
    "class": "elc_policy_constrained",
    "label": "ELC policy-constrained fallback; not an open-market cap-share prediction",
    "uncertainty": "wider interval and coverage=policy_constrained"
  }
}
